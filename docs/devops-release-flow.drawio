        </mxCell>
        <mxCell id="devBranch" parent="laneDev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" value="Cut topic branch&#xa;from main, commit work" vertex="1">
