<mxfile host="Electron" agent="Claude Code">
  <diagram name="DevOps Release Flow" id="release-flow">
    <mxGraphModel dx="1222" dy="837" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1700" math="0" shadow="0">
