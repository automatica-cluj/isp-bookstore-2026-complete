        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1A1A1A;" value="ISP 2026 Bookstore — DevOps Release Flow (GitHub Actions · semantic-release · GHCR)" vertex="1">
          <mxGeometry height="30" width="1020" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="laneDev" parent="1" style="swimlane;startSize=26;html=1;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=top;swimlaneFillColor=#ffffff;" value="1 · Feature branch (cut from main)" vertex="1">
          <mxGeometry height="170" width="1020" x="40" y="70" as="geometry" />
        </mxCell>
