        </mxCell>
        <mxCell id="devPush" parent="laneDev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" value="Push branch /&#xa;open Pull Request → main" vertex="1">
          <mxGeometry height="64" width="170" x="360" y="58" as="geometry" />
        </mxCell>
        <mxCell id="devNote" parent="laneDev" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;fontStyle=2;" value="Trunk-based: main is the only long-lived branch.&#xa;Conventional Commits required." vertex="1">
          <mxGeometry height="64" width="410" x="580" y="58" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="laneDev" source="devStart" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" target="devBranch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="laneDev" source="devBranch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;" target="devPush">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lanePR" parent="1" style="swimlane;startSize=26;html=1;horizontal=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;verticalAlign=top;swimlaneFillColor=#ffffff;" value="2 · Pull Request checks (run on every PR / push to any branch)" vertex="1">
          <mxGeometry height="220" width="1020" x="40" y="265" as="geometry" />
        </mxCell>
        <mxCell id="prTitle" parent="lanePR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;" value="pr-title.yml&#xa;&#xa;Validate PR title is a&#xa;Conventional Commit&#xa;(feat / fix / docs / chore …)" vertex="1">
          <mxGeometry height="100" width="200" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="ciTest" parent="lanePR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;" value="ci.yml · Build and Test&#xa;&#xa;Java 17 · mvn clean compile&#xa;mvn test → JUnit reports&#xa;upload test-results artifact" vertex="1">
          <mxGeometry height="100" width="220" x="290" y="50" as="geometry" />
        </mxCell>
        <mxCell id="ciPkg" parent="lanePR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;" value="ci.yml · Package JAR&#xa;&#xa;mvn clean package -DskipTests&#xa;upload bookstore-jar artifact" vertex="1">
          <mxGeometry height="100" width="220" x="560" y="50" as="geometry" />
        </mxCell>
        <mxCell id="prGate" parent="lanePR" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" value="All checks green?&#xa;Reviewer approves" vertex="1">
          <mxGeometry height="90" width="150" x="830" y="55" as="geometry" />
        </mxCell>
        <mxCell id="prNote" parent="lanePR" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;fontStyle=2;" value="These jobs are gating but never release or publish anything." vertex="1">
          <mxGeometry height="20" width="740" x="40" y="165" as="geometry" />
        </mxCell>
        <mxCell id="merge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=center;" value="Squash-merge PR → main&#xa;(PR title becomes the commit message semantic-release reads)" vertex="1">
