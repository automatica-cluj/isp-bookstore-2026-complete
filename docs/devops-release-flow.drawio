        <mxCell id="relDecide" parent="laneRel" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" value="Release warranted?&#xa;feat→minor · fix/perf/refactor→patch&#xa;breaking→major&#xa;docs/chore/ci/test/build→no release" vertex="1">
