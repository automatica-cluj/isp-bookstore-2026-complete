        </mxCell>
        <mxCell id="laneRel" parent="1" style="swimlane;startSize=26;html=1;horizontal=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;verticalAlign=top;swimlaneFillColor=#ffffff;" value="3 · Release and Publish — build-push.yml (triggered on push to main)" vertex="1">
          <mxGeometry height="640" width="1020" x="40" y="650" as="geometry" />
        </mxCell>
        <mxCell id="semrel" parent="laneRel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=center;fontStyle=1;" value="Run semantic-release&#xa;&#xa;Analyse commits since last tag" vertex="1">
          <mxGeometry height="70" width="200" x="410" y="45" as="geometry" />
